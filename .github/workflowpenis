name: Build Signed SidePlay APK

on:
  workflow_dispatch:
  push:

permissions:
  contents: read

jobs:
  build:
    name: Build Signed Android APK
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Find and extract SidePlay source
        shell: bash
        run: |
          set -e

          echo "=== Repository files ==="
          ls -la

          ZIP_FILE="$(find . -maxdepth 1 -type f \
            -name 'SidePlay-Node-v0.3.1-phone-cloud-builder*.zip' \
            | sort \
            | head -n 1)"

          if [ -z "$ZIP_FILE" ]; then
            echo "ERROR: SidePlay source ZIP not found."
            exit 1
          fi

          echo "Found:"
          echo "$ZIP_FILE"

          rm -rf sideplay
          mkdir -p sideplay

          unzip -q "$ZIP_FILE" -d sideplay

          test -f sideplay/package.json
          test -f sideplay/src/App.tsx
          test -f sideplay/scripts/patch-android.mjs

          echo "SidePlay extracted successfully."

      - name: Set up Node 24
        uses: actions/setup-node@v7
        with:
          node-version: '24'
          package-manager-cache: false

      - name: Set up JDK 21
        uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: '21'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: 'platform-tools platforms;android-36 build-tools;36.0.0'

      - name: Show tool versions
        run: |
          node --version
          npm --version
          java -version

          echo "Android SDK:"
          echo "$ANDROID_SDK_ROOT"

      - name: Install dependencies
        working-directory: sideplay
        run: |
          npm install --no-audit --no-fund

      - name: Build SidePlay web app
        working-directory: sideplay
        run: |
          npm run build

      - name: Create and sync Android project
        working-directory: sideplay
        run: |
          set -e

          if [ ! -d android ]; then
            npx cap add android
          fi

          npx cap sync android

      - name: Apply SidePlay native Android patches
        working-directory: sideplay
        run: |
          set -e

          node scripts/patch-android.mjs

          echo "Checking native files..."

          test -f android/app/src/main/java/app/sideplay/mobile/PlaybackService.java
          test -f android/app/src/main/java/app/sideplay/mobile/BackgroundAudioPlugin.java
          test -f android/app/src/main/java/app/sideplay/mobile/SpotifySessionPlugin.java
          test -f android/app/src/main/java/app/sideplay/mobile/SpotifySessionListenerService.java

          echo "Native files OK."

      - name: Build APK
        working-directory: sideplay/android
        run: |
          set -e

          chmod +x gradlew

          ./gradlew :app:assembleDebug \
            --build-cache \
            --stacktrace \
            --no-daemon

      - name: Locate unsigned APK
        shell: bash
        run: |
          set -e

          APK="sideplay/android/app/build/outputs/apk/debug/app-debug.apk"

          if [ ! -f "$APK" ]; then
            echo "ERROR: app-debug.apk was not generated."
            exit 1
          fi

          echo "APK found:"
          ls -lh "$APK"

          mkdir -p signing
          cp "$APK" signing/SidePlay-unsigned.apk

      - name: Generate SidePlay signing key
        shell: bash
        run: |
          set -e

          keytool \
            -genkeypair \
            -v \
            -keystore signing/sideplay-test.jks \
            -storepass sideplay123 \
            -keypass sideplay123 \
            -alias sideplay \
            -keyalg RSA \
            -keysize 2048 \
            -validity 10000 \
            -dname "CN=SidePlay, OU=Testing, O=SidePlay, L=Santo Domingo, ST=Distrito Nacional, C=DO"

          echo "Signing key created."

      - name: Zipalign APK
        shell: bash
        run: |
          set -e

          ZIPALIGN="$ANDROID_SDK_ROOT/build-tools/36.0.0/zipalign"

          if [ ! -x "$ZIPALIGN" ]; then
            echo "ERROR: zipalign not found."
            exit 1
          fi

          "$ZIPALIGN" \
            -f \
            -p \
            4 \
            signing/SidePlay-unsigned.apk \
            signing/SidePlay-aligned.apk

          "$ZIPALIGN" \
            -c \
            -v \
            4 \
            signing/SidePlay-aligned.apk

      - name: Sign APK
        shell: bash
        run: |
          set -e

          APKSIGNER="$ANDROID_SDK_ROOT/build-tools/36.0.0/apksigner"

          if [ ! -x "$APKSIGNER" ]; then
            echo "ERROR: apksigner not found."
            exit 1
          fi

          mkdir -p release

          "$APKSIGNER" sign \
            --ks signing/sideplay-test.jks \
            --ks-key-alias sideplay \
            --ks-pass pass:sideplay123 \
            --key-pass pass:sideplay123 \
            --out release/SidePlay.apk \
            signing/SidePlay-aligned.apk

          echo "APK signed."

      - name: VERIFY APK SIGNATURE
        shell: bash
        run: |
          set -e

          APKSIGNER="$ANDROID_SDK_ROOT/build-tools/36.0.0/apksigner"

          echo "===================================="
          echo "VERIFYING SIDEPLAY APK"
          echo "===================================="

          "$APKSIGNER" verify \
            --verbose \
            --print-certs \
            release/SidePlay.apk

          echo ""
          echo "✅ APK SIGNATURE VERIFIED"

      - name: Inspect final APK
        shell: bash
        run: |
          set -e

          AAPT="$ANDROID_SDK_ROOT/build-tools/36.0.0/aapt"

          echo "=== APK ==="
          ls -lh release/SidePlay.apk

          echo ""
          echo "=== PACKAGE INFO ==="
          "$AAPT" dump badging release/SidePlay.apk | head -n 20

          echo ""
          echo "=== SHA256 ==="
          sha256sum release/SidePlay.apk | tee release/SHA256.txt

      - name: Create install README
        shell: bash
        run: |
          cat > release/README.txt <<'EOF'
          SIDEPLAY v0.3.1
          Signed Android Test APK

          INSTALL:
          Open SidePlay.apk on your Android phone.

          Package:
          app.sideplay.mobile

          This APK was:
          - built by GitHub Actions
          - zipaligned
          - explicitly signed with apksigner
          - signature verified before upload

          SPOTIFY ENGINE TEST:

          1. Install Spotify.
          2. Open Spotify.
          3. Play any song.
          4. Open SidePlay.
          5. Open SidePlay Settings.
          6. Grant Notification Access.
          7. Enable SidePlay.
          8. Return to SidePlay.
          9. Refresh Spotify engine status.
          10. Check whether PLAY_FROM_SEARCH is supported.
          11. Enable Prefer Spotify for online tracks.
          EOF

      - name: Upload VERIFIED SidePlay APK
        uses: actions/upload-artifact@v4
        with:
          name: SidePlay-v0.3.1-SIGNED-APK
          path: |
            release/SidePlay.apk
            release/SHA256.txt
            release/README.txt
          if-no-files-found: error
          retention-days: 14
