name: Build SidePlay APK

on:
  workflow_dispatch:
  push:

permissions:
  contents: read

jobs:
  build:
    name: Build Android APK
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Find and extract SidePlay source
        shell: bash
        run: |
          set -e

          echo "=== Repository files ==="
          ls -la

          ZIP_FILE="$(find . -maxdepth 1 -type f \
            -name 'SidePlay-Node-v0.3.1-phone-cloud-builder*.zip' \
            | sort \
            | head -n 1)"

          if [ -z "$ZIP_FILE" ]; then
            echo ""
            echo "ERROR: Could not find the SidePlay source ZIP."
            echo ""
            echo "Expected something like:"
            echo "SidePlay-Node-v0.3.1-phone-cloud-builder.zip"
            echo "or:"
            echo "SidePlay-Node-v0.3.1-phone-cloud-builder-1.zip"
            exit 1
          fi

          echo ""
          echo "Found SidePlay ZIP:"
          echo "$ZIP_FILE"

          rm -rf sideplay
          mkdir -p sideplay

          unzip -q "$ZIP_FILE" -d sideplay

          echo ""
          echo "=== Extracted source ==="
          ls -la sideplay

          if [ ! -f sideplay/package.json ]; then
            echo "ERROR: package.json missing after extraction."
            exit 1
          fi

          if [ ! -f sideplay/src/App.tsx ]; then
            echo "ERROR: src/App.tsx missing after extraction."
            exit 1
          fi

          if [ ! -f sideplay/scripts/patch-android.mjs ]; then
            echo "ERROR: scripts/patch-android.mjs missing after extraction."
            exit 1
          fi

          echo ""
          echo "SidePlay source extracted successfully."

      - name: Set up Node 24
        uses: actions/setup-node@v7
        with:
          node-version: '24'
          package-manager-cache: false

      - name: Set up JDK 21
        uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: '21'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: 'platform-tools platforms;android-36 build-tools;36.0.0'

      - name: Show tool versions
        run: |
          echo "=== Node ==="
          node --version

          echo "=== npm ==="
          npm --version

          echo "=== Java ==="
          java -version

          echo "=== Android SDK ==="
          echo "$ANDROID_SDK_ROOT"
          sdkmanager --list_installed || true

      - name: Install JavaScript dependencies
        working-directory: sideplay
        run: |
          npm install --no-audit --no-fund

      - name: Build SidePlay web UI
        working-directory: sideplay
        run: |
          npm run build

      - name: Create and sync Capacitor Android project
        working-directory: sideplay
        run: |
          set -e

          if [ ! -d android ]; then
            echo "Creating Capacitor Android project..."
            npx cap add android
          else
            echo "Android project already exists."
          fi

          echo "Syncing Capacitor..."
          npx cap sync android

      - name: Apply SidePlay native Android patches
        working-directory: sideplay
        run: |
          set -e

          node scripts/patch-android.mjs

          echo ""
          echo "=== Checking native SidePlay files ==="

          test -f android/app/src/main/java/app/sideplay/mobile/PlaybackService.java
          test -f android/app/src/main/java/app/sideplay/mobile/BackgroundAudioPlugin.java
          test -f android/app/src/main/java/app/sideplay/mobile/SpotifySessionPlugin.java
          test -f android/app/src/main/java/app/sideplay/mobile/SpotifySessionListenerService.java

          echo "Native files OK."

      - name: Check Android manifest
        working-directory: sideplay
        run: |
          echo "=== Spotify listener ==="
          grep -n "SpotifySessionListenerService" \
            android/app/src/main/AndroidManifest.xml || true

          echo ""
          echo "=== Playback service ==="
          grep -n "PlaybackService" \
            android/app/src/main/AndroidManifest.xml || true

          echo ""
          echo "=== Permissions ==="
          grep -n "uses-permission" \
            android/app/src/main/AndroidManifest.xml || true

      - name: Build debug APK
        working-directory: sideplay/android
        run: |
          set -e

          chmod +x gradlew

          ./gradlew :app:assembleDebug \
            --build-cache \
            --stacktrace \
            --no-daemon

      - name: Prepare SidePlay APK
        run: |
          set -e

          APK_PATH="sideplay/android/app/build/outputs/apk/debug/app-debug.apk"

          if [ ! -f "$APK_PATH" ]; then
            echo "ERROR: Gradle finished but the APK was not found."
            exit 1
          fi

          mkdir -p release

          cp "$APK_PATH" release/SidePlay-debug.apk

          sha256sum \
            release/SidePlay-debug.apk \
            > release/SHA256.txt

          cat > release/README.txt <<'EOF'
          SidePlay v0.3.1
          Spotify Session Engine
          Debug Android APK

          Package:
          app.sideplay.mobile

          INSTALL
          -------
          Install SidePlay-debug.apk on your Android phone.

          SPOTIFY BACKGROUND ENGINE TEST
          ------------------------------
          1. Make sure Spotify is installed.
          2. Open Spotify.
          3. Play any song once.
          4. Open SidePlay.
          5. Go to Settings.
          6. Tap Grant Notification Access.
          7. Enable SidePlay in Android Notification Access.
          8. Return to SidePlay.
          9. Refresh Spotify engine status.
          10. Enable "Prefer Spotify for online tracks".

          Ideally the engine status should report:
          - Notification access granted
          - Spotify session found
          - PLAY_FROM_SEARCH supported

          If Spotify accepts the command, Spotify becomes the
          actual playback engine and can continue playing with
          SidePlay in the background or the screen locked.
          EOF

          echo ""
          echo "=== Final APK ==="
          ls -lh release

          echo ""
          echo "=== SHA256 ==="
          cat release/SHA256.txt

      - name: Upload SidePlay APK
        uses: actions/upload-artifact@v4
        with:
          name: SidePlay-v0.3.1-APK
          path: release/
          if-no-files-found: error
          retention-days: 14
